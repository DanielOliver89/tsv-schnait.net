prototype(tsv.schnait:Document.AbstractPage) < prototype(Neos.Neos:Page) {
  htmlTag.attributes.lang = 'de'

  # Versions-Parameter aus dem Dateiinhalt, damit Browser nach einem Update nicht die alte Datei aus dem Cache nehmen
  @context.siteCssUri = ${StaticResource.uri('tsv.schnait', 'Public/Styles/Site.css') + '?v=' + String.substr(String.md5(StaticResource.content('tsv.schnait', 'Public/Styles/Site.css')), 0, 8)}
  @context.siteJsUri = ${StaticResource.uri('tsv.schnait', 'Public/JavaScript/tsv.js') + '?v=' + String.substr(String.md5(StaticResource.content('tsv.schnait', 'Public/JavaScript/tsv.js')), 0, 8)}

  head {
    headTags = Neos.Fusion:Component {
      renderer = afx`
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#1874CD" />
      `
    }

    # Seitentitel: "Titel überschreiben" hat Vorrang, danach der Seitentitel; Vereinsname als Suffix
    titleTag = Neos.Fusion:Tag {
      tagName = 'title'
      content = ${q(node).property('titleOverride') ? q(node).property('titleOverride') : q(node).property('title')}
      content.@process.trim = ${String.trim(value)}
      content.@process.suffix = ${value == 'TSV Schnait 1911 e.V.' ? value : value + ' – TSV Schnait 1911 e.V.'}
      content.@process.suffix.@position = 'after trim'
      content.@process.escape = ${String.htmlSpecialChars(value)}
      content.@process.escape.@position = 'end'
    }

    stylesheets.site = afx`
        <link rel="stylesheet" href={StaticResource.uri('tsv.schnait', 'Public/Styles/bootstrap.min.css')} />
        <link rel="stylesheet" href={StaticResource.uri('tsv.schnait', 'Public/Styles/glightbox.min.css')} />
        <link rel="stylesheet" href={siteCssUri} />
        <link rel="icon" href={StaticResource.uri('tsv.schnait', 'Public/Images/favicon.gif')} />
        <link rel="apple-touch-icon" href={StaticResource.uri('tsv.schnait', 'Public/Images/apple-touch-icon.png')} />
    `

    javascripts.site = afx`
        <script defer src={StaticResource.uri('tsv.schnait', 'Public/JavaScript/glightbox.min.js')}></script>
        <script defer src={siteJsUri}></script>
    `
  }

  body = tsv.schnait:Component.Template.Default {
    content = Neos.Neos:PrimaryContent {
      nodePath = 'main'
    }
  }
}
