prototype(tsv.schnait:Presentation.YouTube) < prototype(Neos.Fusion:Component) {
    // This is used for the living styleguide (Monocle)
    // Read more about this in the README.md
    @styleguide.props {
        videoId = '4DVD03IlXIs'
        inBackend = true
    }

    videoId = null
    inBackend = false

    renderer = afx`
        <figure @if={props.videoId} class="tsv-video">
            <iframe
                src={'https://www.youtube-nocookie.com/embed/' + props.videoId + '?wmode=transparent'}
                title="YouTube-Video"
                width="100%"
                height="100%"
                loading="lazy"
                allowfullscreen
            ></iframe>
        </figure>
        <tsv.schnait:Presentation.Alert
            @if={!props.videoId && props.inBackend}
            class="tsv-video"
            content={'Please specify a video ID'}
        />
    `
}