prototype(tsv.schnait:Presentation.FancyImage) < prototype(Neos.Fusion:Component) {
    @styleguide.props.renderDummyImage = true

    src = null
    srcset = null
    sizes = null
    width = null
    height = null
    href = null
    alt = null
    title = null
    class = 'tsv-schnait-fancyimage'
    imageClass = null
    gruppe = 'Fancybox'
    hasCaption = false
    caption = null
    captionText = null
    renderDummyImage = false

    @if.hasSource = ${this.src || this.renderDummyImage}

    renderer = afx`
        <div class={props.class}>
            <figure>
                <a
                    href={props.href || props.src}
                    class="fancybox glightbox"
                    data-gallery={props.gruppe}
                    data-title={props.title ? props.title : props.captionText}
                    title={props.title ? props.title : null}
                >
                    <img
                        src={props.src || StaticResource.uri('Neos.Neos', 'Public/Images/dummy-image.svg')}
                        srcset={props.srcset}
                        sizes={props.srcset ? props.sizes : null}
                        width={props.width}
                        height={props.height}
                        alt={props.alt ? props.alt : ''}
                        class={props.imageClass}
                        loading="lazy"
                        decoding="async"
                    />
                </a>
                <figcaption @if={props.hasCaption && props.caption}>
                    {props.caption}
                </figcaption>
            </figure>
        </div>
    `
}
