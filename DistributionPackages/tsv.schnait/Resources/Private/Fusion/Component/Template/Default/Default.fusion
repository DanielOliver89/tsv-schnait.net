prototype(tsv.schnait:Component.Template.Default) < prototype(Neos.Fusion:Component) {
    content = ''

    impressumNode = ${q(site).children('[instanceof Neos.Neos:Document]').filter('[uriPathSegment="impressum"]').get(0)}

    renderer = afx`
        <a class="tsv-skiplink" href="#main">Zum Inhalt springen</a>
        <div id="wrapper">
            <header class="navigation">
                <tsv.schnait:MainMenu />
            </header>
            <main id="main" class="content">
                <tsv.schnait:Breadcrumb />
                {props.content}
            </main>
            <footer class="footer">
                <div class="footer__inner">
                    <div id="footerLinks">
                        <Neos.Neos:NodeLink node={props.impressumNode} @if.hasNode={props.impressumNode}>Impressum</Neos.Neos:NodeLink>
                    </div>
                    <div id="footerRechts">
                        <Neos.Neos:NodeLink node={site}>© Turn- und Sportverein Schnait 1911 e.V.</Neos.Neos:NodeLink>
                    </div>
                </div>
            </footer>
        </div>
    `
}
